# Server
PORT=3000
NODE_ENV=development

# Database
POKEMON_REPOSITORY=prisma

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Caching
CACHE_TTL=300000
CACHE_MAX_ITEMS=500

# PokeAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT=3000
POKEAPI_ACCEPT=application/json
POKEAPI_USER_AGENT=Backend-Node-Test/1.0
POKEAPI_RETRY_MAX_ATTEMPTS=2
POKEAPI_RETRY_BASE_DELAY_MS=200
POKEAPI_RETRY_MAX_DELAY_MS=1000
POKEAPI_CB_FAILURE_THRESHOLD=3
POKEAPI_CB_OPEN_MS=10000
POKEAPI_CACHE_ENABLED=true
POKEAPI_CACHE_TTL_MS=30000
