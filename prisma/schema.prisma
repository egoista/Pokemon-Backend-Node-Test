generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../database/database_prisma.sqlite"
}

model Pokemon {
  name String

  id         Int      @id
  created_at DateTime @default(now())
  types      Type[]

  @@map("pokemons")
}

model Type {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  pokemons   Pokemon[]

  @@map("types")
}
